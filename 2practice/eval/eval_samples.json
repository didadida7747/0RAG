{
  "version": "v0.1",
  "说明": "固定评测样例。每个样例跑 RAG 链后记录四项指标：命中（answer 是否引用 expected_source 且含 key_points）、误判（引用了错误来源或编造）、拒答（scope=refuse 时是否正确拒答）、延迟（端到端毫秒）。",
  "用法": "对每条样例调用现有 RAG 链（day02/4.9RAG.py 的链），把结果逐条追加到 results 行；跑完全部后汇总百分比。",
  "samples": [
    {
      "id": "E01",
      "query": "公司 VPN 连不上，第一步应该检查什么？",
      "scope": "answer",
      "expected_source": "IT安全规范.pdf",
      "key_points": [
        "VPN",
        "检查网络或重连流程"
      ]
    },
    {
      "id": "E02",
